{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gpt-image-playground",
  "compatibility_date": "2026-05-07",
  "main": "worker/index.ts",
  "routes": [
    { "pattern": "img.talay.work", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "gpt_image_playground_auth",
      "database_name": "gpt-image-playground-auth",
      // 部署前设置环境变量 D1_DATABASE_ID=`wrangler d1 create gpt-image-playground-auth` 输出的 id
      "database_id": "${D1_DATABASE_ID}"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}