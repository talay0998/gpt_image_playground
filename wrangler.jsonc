{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gpt-image-playground",
  "compatibility_date": "2026-05-07",
  "main": "worker/index.ts",
  "routes": [
    { "pattern": "img.talay.work", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "gpt_image_playground_auth",
      "database_name": "gpt-image-playground-auth",
      // 部署前请替换为你的 D1 database_id（运行 `wrangler d1 create gpt-image-playground-auth` 获取）
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}